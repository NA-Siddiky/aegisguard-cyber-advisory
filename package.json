{
  "name": "aegisguard-cyber-portal",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise Cybersecurity Risk Assessment & Improvement Portal for Nexor Digital Bank (MPMIS 516)",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run start:dev --workspace=apps/api\" \"npm run dev --workspace=apps/client\"",
    "dev:api": "npm run start:dev --workspace=apps/api",
    "dev:client": "npm run dev --workspace=apps/client",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
